# Copy to .env.local for local work. On the host, paste the same names with real values.
# Leave a value blank when you do not have it yet. Do not commit filled-in secrets.

# OpenApply API v3, client-credentials, read-only.
OPENAPPLY_CLIENT_ID=
OPENAPPLY_CLIENT_SECRET=
OPENAPPLY_BASE_URL=
OPENAPPLY_TOKEN_URL=
OPENAPPLY_TOUR_EVENT_IDS=

# Google sign-in for people, and the admissions@ account used for Calendar and Docs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=
GOOGLE_ORGANIZER_EMAIL=
GOOGLE_GUEST_EMAILS=
GOOGLE_NOTES_TEMPLATE_DOC_ID=

# Master spreadsheet the app is allowed to write. Source sheets are never written.
GOOGLE_MASTER_SHEET_ID=
GOOGLE_MASTER_SHEET_NAME=
# Whole service-account JSON on one line, or a local file path. Not a student record.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Notion internal integration token. Read-only.
NOTION_TOKEN=

# Random strings. SESSION_SECRET signs the sign-in cookie. CRON_SECRET locks the weekday job.
SESSION_SECRET=
CRON_SECRET=

# Optional. Defaults to risr.ac.th. AUTH_REQUIRED=true forces the sign-in gate during local dev.
ALLOWED_EMAIL_DOMAIN=
AUTH_REQUIRED=

# true, false, or blank. Blank uses sample data until both OpenApply and Google client credentials exist.
MOCK_MODE=
