/**
 * RISR Advancement Office dashboard web app.
 * Deploy from admissions@risr.ac.th.
 * Execute as: User accessing the web app.
 * Who has access: Anyone within risr.ac.th.
 *
 * The page reads and writes Google data with that person's own account.
 * Do not put OpenApply credentials or any other secret in this file.
 * This web app does not call OpenApply. Sync Now and Open House call the
 * webhook addresses saved in the browser, from Apps Script, with no Google token.
 *
 * Index.html is generated by `npm run apps-script`. Serve it with
 * createHtmlOutputFromFile. Do not turn it into an HTML template: the
 * bundle is large and may contain the characters that templates treat as code.
 */

var SCHOOL_DOMAIN = 'risr.ac.th';
var SHEET_BATCH_LIMIT = 12;
var WEBHOOK_BODY_LIMIT = 200000;
var GOOGLE_BODY_LIMIT = 1000000;
var GOOGLE_REPLY_LIMIT = 2000000;

function doGet(e) {
  var page = '';
  try {
    page = (e && e.parameter && e.parameter.page) ? String(e.parameter.page).toLowerCase() : '';
  } catch (err) {
    page = '';
  }
  if (page === 'walkin') {
    var walkin = HtmlService.createHtmlOutputFromFile('Walkin').getContent();
    walkin = walkin.replace(/\{\{DASHBOARD_URL\}\}/g, escapeHtml_(dashboardUrl_() || '#'));
    return HtmlService.createHtmlOutput(walkin)
      .setTitle('Walk-in')
      .setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL)
      .addMetaTag('viewport', 'width=device-width, initial-scale=1');
  }
  return HtmlService.createHtmlOutputFromFile('Index')
    .setTitle('Advancement Office')
    .setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL)
    .addMetaTag('viewport', 'width=device-width, initial-scale=1');
}

function clientBootstrap() {
  assertSchoolEmail_();
  return {
    email: schoolEmail_(),
    walkInUrl: walkInPageUrl_()
  };
}

/**
 * One round trip for several master-sheet tabs.
 * Range matches sheetA1Range in src/lib/standalone/sheet-read.ts: 'Tab'!A1:AZ5000.
 */
function readSheetBatch(spreadsheetId, titles) {
  assertSchoolEmail_();
  var id = String(spreadsheetId || '');
  if (!/^[a-zA-Z0-9_-]{20,}$/.test(id)) throw new Error('The master spreadsheet id is not valid.');
  if (!titles || !titles.length) return [];
  if (titles.length > SHEET_BATCH_LIMIT) throw new Error('Ask for fewer sheet tabs at once.');
  var token = ScriptApp.getOAuthToken();
  var requests = [];
  for (var i = 0; i < titles.length; i++) {
    var title = String(titles[i] || '');
    if (!title || title.length > 100 || /[\r\n]/.test(title)) throw new Error('A sheet tab name is not valid.');
    var range = sheetA1Range_(title);
    var url = 'https://sheets.googleapis.com/v4/spreadsheets/' + encodeURIComponent(id) + '/values/' + encodeURIComponent(range);
    requests.push({
      url: url,
      method: 'get',
      headers: { Authorization: 'Bearer ' + token },
      muteHttpExceptions: true
    });
  }
  var responses = UrlFetchApp.fetchAll(requests);
  var rows = [];
  for (var r = 0; r < responses.length; r++) {
    var code = responses[r].getResponseCode();
    var text = '';
    try {
      text = responses[r].getContentText() || '';
    } catch (err) {
      text = '';
    }
    var values = [];
    var detail = '';
    if (code >= 200 && code < 300) {
      var parsed = {};
      try {
        parsed = JSON.parse(text || '{}');
      } catch (err) {
        throw new Error('Sheets returned data this page could not read.');
      }
      values = tableOf_(parsed.values);
    } else {
      detail = String(text).replace(/\s+/g, ' ').trim().slice(0, 240);
    }
    rows.push({ title: String(titles[r]), status: code, values: values, detail: detail });
  }
  return rows;
}

function proxyApi(request) {
  assertSchoolEmail_();
  request = request || {};
  var purpose = String(request.purpose || '');
  if (purpose === 'webhook') return proxyWebhook_(request);
  if (purpose === 'google') return proxyGoogle_(request);
  throw new Error('Unknown request.');
}

function proxyGoogle_(request) {
  var method = String(request.method || 'GET').toUpperCase();
  var url = String(request.url || '');
  var body = String(request.body || '');
  if (!googleApiAllowed_(url)) throw new Error('That Google address is not used by this dashboard.');
  if (method !== 'GET' && method !== 'POST' && method !== 'PATCH' && method !== 'PUT') {
    throw new Error('That request is not allowed.');
  }
  if (body.length > GOOGLE_BODY_LIMIT) throw new Error('That request is too large.');
  if (url.indexOf('https://www.googleapis.com/calendar/') === 0) assertCalendarWrite_(method, url, body);
  var options = {
    method: method.toLowerCase(),
    headers: { Authorization: 'Bearer ' + ScriptApp.getOAuthToken() },
    muteHttpExceptions: true,
    followRedirects: false
  };
  if (method !== 'GET' && body) {
    options.contentType = 'application/json';
    options.payload = body;
  }
  var response = UrlFetchApp.fetch(url, options);
  var text = '';
  try {
    text = response.getContentText() || '';
  } catch (err) {
    text = '';
  }
  if (text.length > GOOGLE_REPLY_LIMIT) throw new Error('The Google reply was too large to send back to the page.');
  return { status: response.getResponseCode(), body: text };
}

function proxyWebhook_(request) {
  var method = String(request.method || 'POST').toUpperCase();
  if (method !== 'POST') throw new Error('Webhooks only accept POST.');
  var url = String(request.url || '').trim();
  var parsed = parseHttpsUrl_(url);
  if (!parsed) throw new Error('The webhook URL must be https.');
  if (googleApiHost_(parsed.host) || privateOrLocalHost_(parsed.host)) throw new Error('That address is not a webhook.');
  var body = String(request.body || '');
  if (body.length > WEBHOOK_BODY_LIMIT) throw new Error('The webhook body is too large.');
  var headers = {};
  var extra = request.headers || {};
  var authorization = extra.Authorization || extra.authorization || '';
  if (authorization) headers.Authorization = String(authorization).slice(0, 2000);
  var response = UrlFetchApp.fetch(url, {
    method: 'post',
    contentType: 'application/json',
    payload: body,
    headers: headers,
    muteHttpExceptions: true,
    followRedirects: true
  });
  return { status: response.getResponseCode(), body: '' };
}

function assertCalendarWrite_(method, url, body) {
  if (method === 'GET' || method === 'HEAD') return;
  var parsed = parseHttpsUrl_(url);
  var query = parsed ? parsed.query : '';
  var sendUpdates = queryValue_(query, 'sendUpdates');
  if (sendUpdates !== 'none') throw new Error('Calendar writes must use sendUpdates=none.');
  if (/conferenceData/i.test(body) || /hangoutLink/i.test(body)) throw new Error('Calendar writes cannot include Meet.');
  if (method === 'POST' && /OA Registration ID\s*:/i.test(body)) {
    throw new Error('Tour calendar events cannot include an OpenApply Registration ID.');
  }
}

function sheetA1Range_(title) {
  return "'" + String(title).replace(/'/g, "''") + "'!A1:AZ5000";
}

function tableOf_(values) {
  if (!values || !values.length) return [];
  return values.map(function (row) {
    return (row || []).map(function (cell) {
      if (cell == null) return '';
      return String(cell);
    });
  });
}

function dashboardUrl_() {
  try {
    var url = ScriptApp.getService().getUrl();
    return url ? String(url) : '';
  } catch (err) {
    return '';
  }
}

function walkInPageUrl_() {
  var base = dashboardUrl_();
  if (!base) return '';
  if (base.indexOf('?') === -1) return base + '?page=walkin';
  return base + '&page=walkin';
}

function schoolEmail_() {
  try {
    return String(Session.getActiveUser().getEmail() || '').trim().toLowerCase();
  } catch (err) {
    return '';
  }
}

function assertSchoolEmail_() {
  var email = schoolEmail_();
  if (!email) return '';
  var parts = email.split('@');
  if (parts.length !== 2 || !parts[0] || parts[1] !== SCHOOL_DOMAIN) {
    throw new Error('Sign in with a @risr.ac.th account.');
  }
  return email;
}

function googleApiAllowed_(value) {
  var parsed = parseHttpsUrl_(value);
  if (!parsed) return false;
  if (parsed.host === 'sheets.googleapis.com') return parsed.path.indexOf('/v4/spreadsheets/') === 0;
  if (parsed.host === 'docs.googleapis.com') return parsed.path.indexOf('/v1/documents/') === 0;
  if (parsed.host !== 'www.googleapis.com') return false;
  if (parsed.path.indexOf('/calendar/v3/calendars/') === 0) return true;
  return parsed.path === '/oauth2/v3/userinfo';
}

function googleApiHost_(host) {
  return host === 'sheets.googleapis.com' || host === 'www.googleapis.com' || host === 'docs.googleapis.com' || host === 'oauth2.googleapis.com' || host === 'googleapis.com';
}

function privateOrLocalHost_(host) {
  var name = String(host || '').split(':')[0].toLowerCase();
  if (name === 'localhost' || name.slice(-10) === '.localhost' || name.slice(-6) === '.local') return true;
  if (name === 'metadata.google.internal') return true;
  var parts = name.split('.');
  if (parts.length !== 4) return false;
  var nums = [];
  for (var i = 0; i < 4; i++) {
    if (!/^\d{1,3}$/.test(parts[i])) return false;
    var n = Number(parts[i]);
    if (n > 255) return true;
    nums.push(n);
  }
  if (nums[0] === 10 || nums[0] === 127 || nums[0] === 0) return true;
  if (nums[0] === 169 && nums[1] === 254) return true;
  if (nums[0] === 192 && nums[1] === 168) return true;
  if (nums[0] === 172 && nums[1] >= 16 && nums[1] <= 31) return true;
  return false;
}

function parseHttpsUrl_(value) {
  var url = String(value || '').trim();
  var match = url.match(/^(https):\/\/([^\/?#]+)([^?#]*)(\?[^#]*)?$/i);
  if (!match) return null;
  if (match[2].indexOf('@') !== -1) return null;
  return {
    protocol: 'https:',
    host: match[2].toLowerCase().split(':')[0],
    path: match[3] || '/',
    query: (match[4] || '').replace(/^\?/, '')
  };
}

function queryValue_(query, key) {
  var parts = String(query || '').split('&');
  for (var i = 0; i < parts.length; i++) {
    var pair = parts[i].split('=');
    if (decodeURIComponent(pair[0] || '') === key) return decodeURIComponent(pair.slice(1).join('=') || '');
  }
  return '';
}

function escapeHtml_(value) {
  return String(value)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/"/g, '&quot;');
}
